# test cube - same geometry as the hardcoded version
# 8 vertices, 6 quad faces (fan-triangulates to the same 12 triangles)
# OBJ indices are 1-based, so vertex 0 in your array is "1" here

v -1.0 -1.0 -1.0
v  1.0 -1.0 -1.0
v  1.0  1.0 -1.0
v -1.0  1.0 -1.0
v -1.0 -1.0  1.0
v  1.0 -1.0  1.0
v  1.0  1.0  1.0
v -1.0  1.0  1.0

# comment lines and unused tags below should be skipped by the parser
vn 0.0 0.0 1.0
vt 0.5 0.5
usemtl none
s off

f 3 2 1 4
f 5 6 7 8
f 8 7 3 4
f 2 6 5 1
f 2 3 7 6
f 8 4 1 5
