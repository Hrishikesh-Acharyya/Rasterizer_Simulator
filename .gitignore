
# build output
*.exe
*.o

# The POSIX build target. $(TARGET) is renderer.exe on Windows, covered by
# *.exe above, but a plain "renderer" on Linux and macOS -- which nothing here
# matched, so a build on those platforms left an untracked 40 KB binary sitting
# in the working tree waiting to be committed by accident.
renderer

# The other POSIX build target, for the same reason: $(DIFF_TARGET) is
# ppmdiff.exe on Windows and a bare "ppmdiff" everywhere else. `make` builds
# both programs, so a plain build left this one untracked next to the renderer.
ppmdiff

# render output
*.ppm
frames/
frames_s*/


# generated documentation
docs/

